*.tsbuildinfo

# CDK
infra/dist
infra/cdk.out
infra/*.js
infra/*.d.ts

# Content lives in the Content_Repo now (content-storage stage 7), not here. Everything
# at public/content is local-only: the generated manifests, and the symlink `make dev`
# creates to a Content_Repo clone so the dev server has content to serve. Both forms —
# `make dev` makes it a symlink (matched without the slash), and a plain generated dir is
# matched with it.
public/content
public/content/

# Other generated build artifacts.
public/search-index.json
public/rss.xml
public/sitemap.xml
# Generated too, since it embeds the absolute sitemap URL.
public/robots.txt

# CDK's context cache. No longer produced: the hosted zone comes from site.config.json
# rather than a Route53 lookup, so there is nothing to cache. Ignored so a stray one —
# from an older checkout, or a lookup added later — cannot be committed, because the
# cache key embeds the AWS account ID.
infra/cdk.context.json

# Environment files. Ignore everything starting with .env, then re-include the one
# file that is deliberately tracked.
#
# admin/.env.production holds only the Cognito user pool and app client IDs — public
# identifiers that ship in the browser bundle, so committing them leaks nothing. It is
# tracked because the CI job that builds the admin SPA has no AWS credentials and so
# cannot generate it; see the header of scripts/admin-env.js. It is generated by
# `make admin-env`, not edited by hand.
#
# The broad pattern also catches macOS duplication artifacts like ".env 2.production",
# which a narrower rule missed. One of those was sitting untracked and unignored, one
# `git add .` away from being committed.
.env*
!admin/.env.production

# macOS duplication artifacts. Finder and some sync tools create "name 2.ext" copies;
# this repository has collected several, including two empty directories under admin/src.
* 2
* 2.*
dist-projection/

# Content_Repo clone created by the CI build job (content-storage stage 7). Build input,
# never committed.
content-repo/
