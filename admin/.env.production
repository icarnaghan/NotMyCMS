# Generated by scripts/generate-admin-env.js from CloudFormation exports.
# Do not edit by hand: run `make admin-env` after a deploy instead.
#
# These are the only two values the admin cannot derive from site.config.json.
# They are public identifiers (a Cognito pool id and a PKCE SPA client id with no
# secret), embedded in the shipped bundle and visible to any visitor, so they are not
# secrets — but they are deployment-specific. The placeholders below are overwritten by
# `make admin-env` once the admin stack is deployed.

VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
